{
  "name": "pi-threading-workspace",
  "private": true,
  "description": "Workspace root for pi-threading (the extension) and pi-threading-cli (the standalone human-operator CLI)",
  "type": "module",
  "scripts": {
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "pnpm -r run test:unit",
    "test:e2e": "pnpm --filter pi-threading run test:e2e",
    "http-server": "pnpm --filter pi-threading run http-server",
    "live": "pnpm --filter pi-threading run live",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.5.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "volta": {
    "node": "26.4.0"
  }
}
